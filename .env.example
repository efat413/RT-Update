# ==============================================================================
# RONGDHONU TRADE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# SECURITY ARCHITECTURE & CLIENT ISOLATION:
# - All variables listed in this file are STRICTLY SERVER-ONLY.
# - NEVER prefix sensitive variables with VITE_ (Vite embeds VITE_* into client bundles).
# - The React SPA client never accesses process.env or import.meta.env; it communicates
#   exclusively with the backend through relative /api/* endpoints.
# - In production (Cloudflare Workers), sensitive secrets MUST be provisioned using:
#     npx wrangler secret put <SECRET_NAME>
# - Non-sensitive configuration can be placed in wrangler.json under the "vars" section.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION SECRETS (STRICTLY SERVER-ONLY)
# ------------------------------------------------------------------------------
# These secrets MUST be provisioned in production via Cloudflare Worker Secrets:
#   npx wrangler secret put ADMIN_SECRET
#   npx wrangler secret put COURIER_WEBHOOK_SECRET
#   npx wrangler secret put STEADFAST_API_KEY
#   npx wrangler secret put STEADFAST_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY
#
# In local development, they can be provided via .env or system environment variables.

# Core administrative and session encryption secret (minimum 32 characters recommended).
# Used for PBKDF2 password hashing, session tokens, and cryptographic signing.
# Production strictly fails closed (SERVER_CONFIGURATION_ERROR) if this secret is missing.
ADMIN_SECRET=your-secure-admin-secret-minimum-32-chars-long

# Dedicated courier webhook signing secret.
# Used to authenticate incoming status webhooks (/api/webhook/steadfast) via HMAC-SHA256.
# Explicitly segregated from ADMIN_SECRET to prevent credential privilege escalation.
COURIER_WEBHOOK_SECRET=your-courier-webhook-hmac-secret-key

# Steadfast Courier API Key for dispatching parcels and tracking consignments.
STEADFAST_API_KEY=your-steadfast-courier-api-key

# Steadfast Courier Secret Key for courier API authentication and webhook fallback.
STEADFAST_SECRET_KEY=your-steadfast-courier-secret-key

# Resend Email API Key for sending transactional emails (e.g., password reset tokens).
# Can be obtained from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 2. PUBLIC & NON-SECRET CONFIGURATION (SERVER-SIDE)
# ------------------------------------------------------------------------------
# In production, these can be placed directly in wrangler.json under "vars".

# Authoritative public base URL of the website.
# Required for generating absolute password reset URLs in transactional emails:
#   ${APP_URL}/reset-password?token=...
APP_URL=https://rongdhonutrade.com

# Sender email address for transactional emails sent via Resend.
# Must use a verified domain in your Resend account.
RESEND_FROM_EMAIL=support@rongdhonutrade.com

# Comma-separated list of email addresses granted initial super_admin privileges.
# Checked during user registration and authentication bootstrap.
SUPER_ADMIN_EMAILS=admin@rongdhonutrade.com,cmt413uec@gmail.com

# Optional comma-separated list of database user IDs granted super_admin privileges.
# Example: usr_super_admin_001,usr_super_admin_002
SUPER_ADMIN_USER_IDS=

# Canonical production origin for strict CORS and CSRF origin verification.
PRODUCTION_ORIGIN=https://rongdhonutrade.com

# Optional comma-separated list of additional allowed CORS origins.
# Example: https://rongdhonutrade.com,https://admin.rongdhonutrade.com
ALLOWED_ORIGINS=https://rongdhonutrade.com

# ------------------------------------------------------------------------------
# 3. OPTIONAL DEVELOPMENT VARIABLES (LOCAL RUNTIME ONLY)
# ------------------------------------------------------------------------------
# These variables only affect local development (vite / local dev server).
# They are never used or read in Cloudflare Workers production.

# Optional initial seed password for local dev super_admin account (admin@rongdhonu.com).
# If omitted in dev, a secure development credential is automatically derived.
DEV_ADMIN_PASSWORD=

# Node.js runtime environment mode: development | production | test
NODE_ENV=development

# Optional flag to disable Vite Hot Module Replacement (HMR) if running behind reverse proxies
DISABLE_HMR=false
